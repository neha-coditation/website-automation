# Neon PostgreSQL — use the pooled connection string for runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Authentication (Google OAuth application)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI provider — keep keys server-side only
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Optional news/search provider (not yet wired to ingestion)
NEWS_API_KEY=""

# LinkedIn OAuth application
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/integrations/linkedin/callback"
LINKEDIN_API_VERSION=""

# Generate with: openssl rand -base64 32
SOCIAL_TOKEN_ENCRYPTION_KEY=""

# Protect the scheduled publishing endpoint; send as Authorization: Bearer <secret>
CRON_SECRET=""

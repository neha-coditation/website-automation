# Neon PostgreSQL — use the pooled connection string for runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# AI provider — keep keys server-side only
OPENAI_API_KEY=""

# Optional news/search provider
NEWS_API_KEY=""

# Authentication secrets will be added with the authentication phase
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
